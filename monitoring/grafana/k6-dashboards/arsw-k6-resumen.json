    {
      "id": 10,
      "type": "table",
      "title": "Finalizaci\u00f3n de cada ejecuci\u00f3n UTC",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_k6_summary_finished_timestamp_seconds{profile=~\"${profile:regex}\",run=~\"${run:regex}\"} * 1000",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "profile": "Perfil",
              "run": "Ejecuci\u00f3n",
              "Value": "Finalizaci\u00f3n UTC"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Finalizaci\u00f3n UTC"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Finalizaci\u00f3n UTC",
            "desc": true
          }
        ]
      }
    },
